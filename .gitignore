# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
/test-results/
/playwright-report/
/playwright/.cache/

# copy-dist stages here before swapping into docs/ — same filesystem as the
# target, so the rename cannot fail with EXDEV. Removed on exit; ignored in case
# a run is killed mid-flight.
.copy-dist-*

# App Store submission bundles, written next to each app's package.json by the
# zip-for-app-store build plugin. Regenerated on every build; deliberately
# outside dist/, which copy-dist's allowlist would reject them from.
*.zip

# Generated by create-cytoscape-app's sync-templates from the real example apps.
# Not committed: it would be a second copy of files that already live in
# project-template/ and network-statistics/, which is the drift this avoids.
packages/create-cytoscape-app/templates/
